# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='http://localhost:11434'

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='*'

# Set to false to keep memory tools enabled without adding memory context to the system context.
ENABLE_MEMORY_SYSTEM_CONTEXT=true

# Set to false to disable workspace Tools and Functions.
ENABLE_PLUGINS=true

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Valkey Vector Store (requires VECTOR_DB=valkey)
# VALKEY_URL='valkey://localhost:6379'
# VALKEY_COLLECTION_PREFIX='open_webui'
# VALKEY_INDEX_TYPE='HNSW'
# VALKEY_DISTANCE_METRIC='COSINE'
# VALKEY_HNSW_M='16'
# VALKEY_HNSW_EF_CONSTRUCTION='200'
# VALKEY_HNSW_EF_RUNTIME='10'

# VESQOR — answer comparison page (VQ-25, admin only)
# Each provider needs its own three variables and nothing else: there are no
# fallbacks to OPENAI_API_KEY, GEMINI_API_KEY or VESQOR_SERVICE_TOKEN. An unset
# variable means the page reports that provider as "requires configuration" —
# a model id is never guessed, and a credential is never borrowed from another
# integration, because sending one provider's key to another provider's endpoint
# is a leak, and quietly answering a VESQOR column from OpenAI is a wrong result
# that looks like a right one.
# ChatGPT
# ANSWER_COMPARE_CHATGPT_API_KEY=
# ANSWER_COMPARE_CHATGPT_MODEL=
# ANSWER_COMPARE_CHATGPT_BASE_URL=      # default: https://api.openai.com/v1
# Gemini (OpenAI-compatible endpoint)
# ANSWER_COMPARE_GEMINI_API_KEY=
# ANSWER_COMPARE_GEMINI_MODEL=
# ANSWER_COMPARE_GEMINI_BASE_URL=       # default: https://generativelanguage.googleapis.com/v1beta/openai
# VESQOR engine — the OpenAI-compatible door, not the billing proxy.
# The key is the same bs_live_… agent token the chat connection uses: rotate it
# here whenever you rotate it there, or this page starts failing on its own.
# The model is a router key, e.g. vesqor-reasoning.
# The base URL has no default — it differs per deployment and must be set.
# ANSWER_COMPARE_VESQOR_API_KEY=
# ANSWER_COMPARE_VESQOR_MODEL=
# ANSWER_COMPARE_VESQOR_BASE_URL=
# Independent judge — Claude Sonnet, Anthropic Messages format (/v1/messages),
# reached through Kie.ai by default or Anthropic directly. It judges the three
# answers and never generates one, so it has no MAX_INPUT_CHARS of its own.
# Same three-variable rule, no fallbacks (ANTHROPIC_API_KEY is never read).
# ANSWER_COMPARE_SONNET_API_KEY=
# ANSWER_COMPARE_SONNET_MODEL=          # e.g. claude-sonnet-4-6
# ANSWER_COMPARE_SONNET_BASE_URL=       # default: https://api.kie.ai/claude
# Output limit for one judgement (default 4096). Do not raise it on Kie: 8192
# makes Kie answer HTTP 500 after ~110 s (its gateway timeout), while 4096 fits a
# report with headroom. A report that hits the limit fails as `truncated`.
# ANSWER_COMPARE_SONNET_MAX_TOKENS=4096
# Anthropic structured output (schema-constrained step). Off by default: Kie
# accepts the field and silently ignores it, so only a real Anthropic endpoint
# should switch it on. Kie returns the report inside a ```json fence; that is
# parsed as is.
# ANSWER_COMPARE_SONNET_STRUCTURED_OUTPUT=false
# Who may judge. Since 2026-09-15 the three participants do NOT judge by default
# — a model scoring answers it also wrote recognises its own style and votes for
# itself — and the independent judge does. Override per deployment:
# ANSWER_COMPARE_CHATGPT_CAN_JUDGE=true   # brings a participant judge back
# ANSWER_COMPARE_SONNET_CAN_JUDGE=false   # switches the independent judge off
# Optional knobs — every one of these has a working default.
# Read timeout for one generation, in seconds (default 180). Reasoning models are
# slow; keep this BELOW any proxy timeout in front of the app, or the page sees a
# dropped connection instead of a proper "timed out" message.
# ANSWER_COMPARE_REQUEST_TIMEOUT_SECONDS=
# Pre-flight input limit per provider, in CHARACTERS (default 100000). This is our
# own guard, not the provider's context window: oversized input is refused before
# anything is sent, and is never truncated. Exceeding the real context window
# still happens upstream and is reported separately.
# ANSWER_COMPARE_CHATGPT_MAX_INPUT_CHARS=
# ANSWER_COMPARE_GEMINI_MAX_INPUT_CHARS=
# ANSWER_COMPARE_VESQOR_MAX_INPUT_CHARS=
# Pre-flight input limit for judging, in CHARACTERS (default 4 x that provider's
# generation limit above; 4 x 100000 for Sonnet, which has no generation limit).
# A judge reads the prompt, the reference and all the answers at once, so it
# needs more room than one generation.
# ANSWER_COMPARE_CHATGPT_JUDGE_MAX_INPUT_CHARS=
# ANSWER_COMPARE_GEMINI_JUDGE_MAX_INPUT_CHARS=
# ANSWER_COMPARE_VESQOR_JUDGE_MAX_INPUT_CHARS=
# ANSWER_COMPARE_SONNET_JUDGE_MAX_INPUT_CHARS=
